# Bigdata API Key — optional server default. If unset, every client must send X-API-KEY
# (same Bigdata key) on job/report routes and when creating reports.
BIGDATA_API_KEY=your_bigdata_api_key_here

# LLM Provider Configuration
# Set to 'auto' for auto-detection, 'openai' for OpenAI, or 'gemini' for Google Gemini
LLM_PROVIDER=auto

# OpenAI API Key (required if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

## OR ##
# Google Gemini API Key (required if using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Database connection string (SQLite by default)
DB_STRING=sqlite:///jobs.db

# Server port
PORT=8003

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
